# --- LLM: Groq free tier (https://console.groq.com, no card required) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
CONSEARCH_MODEL=openai/gpt-oss-20b

# --- Alternatives: uncomment one block and comment the Groq block above ---
# Google Gemini free tier (https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza...
# CONSEARCH_MODEL=<a Gemini Flash model name from Google's docs>

# OpenRouter (some models are free; their names end in :free)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# CONSEARCH_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama, fully local, no key (run `ollama pull <model>` first; pick a model that supports tools)
# LLM_BASE_URL=http://localhost:11434/v1
# CONSEARCH_MODEL=llama3.1

# --- Search (all free) ---
SEARCH_PROVIDER=duckduckgo        # duckduckgo | wikipedia | searxng
# SEARXNG_URL=http://localhost:8080   # only for SEARCH_PROVIDER=searxng

# --- Optional tuning ---
CONSEARCH_MAX_STEPS=6
CONSEARCH_TOP_K=5
CONSEARCH_HISTORY_TURNS=6
CONSEARCH_EMBEDDER=tfidf
